APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Business details (shown on the portal, SMS and receipts)
BUSINESS_NAME="${APP_NAME}"
BUSINESS_PHONE=
BUSINESS_LOCATION=

# First admin account created by `php artisan migrate --seed`.
# Set a strong password; if omitted the seeder generates and prints one.
ADMIN_EMAIL=admin@wifi.local
ADMIN_PASSWORD=

# Router driver: mock (development) or routeros (real MikroTik)
ROUTER_DRIVER=mock
ROUTER_HOST=192.168.88.1
ROUTER_API_PORT=8728
ROUTER_USER=
ROUTER_PASSWORD=
ROUTER_HOTSPOT_SERVER=hotspot1
# Optional extra hosts allowed in link-login-only, comma separated.
# ROUTER_HOST is always allowed.
ROUTER_ALLOWED_LOGIN_HOSTS=

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS base URL used to build /api/mpesa/callback/{secret}.
# Must be reachable by Safaricom (tunnel URL), not the LAN portal address.
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
# Optional comma-separated CIDRs, e.g. 196.201.214.0/24,196.201.215.0/24
MPESA_ALLOWED_IPS=

# SMS is disabled by default; enable only after the SMS phase is ready.
SMS_ENABLED=false

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Logging (daily files retained for 14 days)
LOG_LEVEL=info
LOG_STACK=daily
LOG_DAILY_DAYS=14

# Session hardening (requires HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Reverse proxies allowed to set X-Forwarded-* (ngrok/Cloudflare Tunnel).
# Keep this to the local proxy address unless a load balancer sits in front.
TRUSTED_PROXIES=127.0.0.1,::1
