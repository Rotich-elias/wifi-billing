[Unit]
Description=WiFi Billing scheduler (runs schedule:work)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wifi-billing
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=150
StandardOutput=append:/var/log/wifi-billing/scheduler.log
StandardError=append:/var/log/wifi-billing/scheduler.log

[Install]
WantedBy=multi-user.target
